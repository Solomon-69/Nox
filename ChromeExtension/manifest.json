{
  "manifest_version": 3,
  "name": "Nox",
  "version": "1.2.0",
  "description": "Turns web pages dark when Nox turns your computer dark.",
  "key": "",
  "icons": {"128": "images/icon-128.png"},
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}
  ]
}
